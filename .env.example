# 复制成 .env 再填自己的值（.env 已被 .gitignore 排除，不会上传）
PG_HOST=localhost
PG_PORT=5432
PG_DB=etf
PG_USER=postgres
PG_PASSWORD=your_password

# ============ 只有上线部署才需要（本地别填，否则每次打开都要登录）============
# 访问密码：设了 APP_PASSWORD 就会弹浏览器账号密码框（用户名默认 etf）
# APP_USER=etf
# APP_PASSWORD=换成你自己的密码
# 连云端数据库（Neon/Supabase 强制 SSL）时打开：
# PGSSLMODE=require
